# Copy to .env.local and adjust. All Vite client vars must start with VITE_.

# Base origin for the API. Matches server/paths.txt ("/api").
# In dev with a separate server, e.g. http://localhost:5000/api
VITE_API_URL=/api

# While the backend does not exist, screens run off src/lib/mockData.js.
# Set to "false" to hit the real API defined by VITE_API_URL.
VITE_USE_MOCKS=true

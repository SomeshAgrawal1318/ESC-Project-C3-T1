# Copy this file to `.env` (in the same /server folder) and fill in real values.
# The .env file is git-ignored so your secrets never end up in version control.

# Get a free API key from Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=paste-your-gemini-api-key-here

# The Gemini model to use. Must be a free-tier vision-capable Flash model.
# gemini-3-flash-preview is free and works with new API keys (older models
# like gemini-2.5-flash are retired for keys created after mid-2026).
GEMINI_MODEL=gemini-3-flash-preview

# MongoDB connection string.
# Local MongoDB:  mongodb://127.0.0.1:27017/lexipath
# Or a free Atlas cluster: mongodb+srv://<user>:<password>@<cluster>/lexipath
MONGODB_URI=mongodb://127.0.0.1:27017/lexipath

# Port for the Express server. The client dev server proxies /api requests here.
PORT=5000

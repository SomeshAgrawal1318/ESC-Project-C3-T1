PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/lexipath

# Recommendation engine. Mock mode is the safe default for local development.
RECOMMENDATION_USE_MOCKS=true

# Required when RECOMMENDATION_USE_MOCKS=false.
GEMINI_API_KEY=replace-with-a-local-secret
GEMINI_MODEL_NAME=gemini-flash-latest
GEMINI_TIMEOUT_MS=30000
GEMINI_MAX_RETRIES=2

# Flag lower-confidence handwriting classifications for educator review.
ERROR_CONFIDENCE_THRESHOLD=0.6

# Private Azure Blob source for wiki retrieval and worksheet PDF streaming.
# Keep the real SAS token only in the ignored server/.env file.
AZURE_STORAGE_ACCOUNT_NAME=replace-with-storage-account
AZURE_STORAGE_CONTAINER_NAME=worksheets
AZURE_STORAGE_SAS_TOKEN=replace-with-a-read-only-container-sas
AZURE_KNOWLEDGE_MANIFEST_PATH=_manifests/gemini-canonical-markdown.jsonl
AZURE_ASSET_MANIFEST_PATH=_manifests/blob-upload-manifest.json
AZURE_FETCH_TIMEOUT_MS=15000
AZURE_MAX_DOCUMENT_BYTES=1048576
AZURE_MAX_MANIFEST_BYTES=5242880
AZURE_MAX_WORKSHEET_BYTES=20971520

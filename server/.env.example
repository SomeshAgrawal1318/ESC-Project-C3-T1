# Database and HTTP server
MONGODB_URI=<mongodb-connection-string>
PORT=4000

# Gemini settings shared by classification and live recommendations
GEMINI_API_KEY=<gemini-api-key>
GEMINI_MODEL_NAME=gemini-flash-latest
GEMINI_TIMEOUT_MS=30000
GEMINI_MAX_RETRIES=2

# Classification confidence threshold (0-1)
ERROR_CONFIDENCE_THRESHOLD=0.6

# Recommendations run without external services unless live mode is explicitly enabled.
RECOMMENDATION_USE_MOCKS=true

# Required only when RECOMMENDATION_USE_MOCKS=false.
# The SAS token needs read access to the private worksheet container.
AZURE_STORAGE_ACCOUNT_NAME=<storage-account-name>
AZURE_STORAGE_CONTAINER_NAME=<container-name>
AZURE_KNOWLEDGE_MANIFEST_PATH=_manifests/gemini-canonical-markdown.jsonl
AZURE_STORAGE_SAS_TOKEN=<container-read-sas-token>

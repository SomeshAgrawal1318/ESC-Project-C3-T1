# Copy this file to .env and fill in real values. .env is git-ignored.

# --- shared ---
MONGODB_URI=
PORT=5000

# --- Error Classification Engine (server/services/errorClassificationEngine.js) ---

# Leave blank to run in mock mode (default when unset): analysis returns a
# fixed, realistic fixture instead of calling Gemini. Set a real key to
# enable the live integration.
GEMINI_API_KEY=

# Force mock mode on/off explicitly. If unset, mock mode is used whenever
# GEMINI_API_KEY is blank.
USE_MOCK_AI=true

# Use the "-latest" alias: pinned model versions get retired for new API keys.
GEMINI_MODEL_NAME=gemini-flash-latest
GEMINI_TIMEOUT_MS=30000
GEMINI_MAX_RETRIES=2

# Confidence score (0-1) below which a detected error is flagged "uncertain"
# for the educator instead of a silent AI guess.
ERROR_CONFIDENCE_THRESHOLD=0.6
